{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plot Workbench",
  "mainBinaryName": "PlotWorkbench",
  "version": "1.0.0",
  "identifier": "io.github.pawafa666-eng.plotworkbench",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "createUpdaterArtifacts": false,
    "icon": [
      "../assets/workbench/128x128.png",
      "../assets/workbench/icon.png",
      "../assets/workbench/icon.ico"
    ],
    "resources": {
      "../dist/Tavotto": "sidecar/Tavotto",
      "../LICENSE": "LICENSE",
      "../docs/workbench/ATTRIBUTION.txt": "ATTRIBUTION.txt",
      "../docs/workbench/usage.md": "usage.md"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "template": "windows/installer.nsi",
        "installerIcon": "../assets/workbench/icon.ico",
        "headerImage": "../assets/workbench/installer-header.bmp",
        "sidebarImage": "../assets/workbench/installer-sidebar.bmp"
      }
    },
    "shortDescription": "绘图工作台 · 本地科研绘图",
    "publisher": "Plot Workbench contributors",
    "copyright": "Plot Workbench contributors; derived from Tavotto (AGPL-3.0-only)",
    "homepage": "https://github.com/pawafa666-eng/plot-workbench"
  }
}
